<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Mapa en vivo con Leaflet y Google Sheets</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Estilos de Leaflet -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

  <style>
    #map {
      height: 100vh; /* El mapa ocupa toda la pantalla */
      width: 100%;
    }
  </style>
</head>
<body>
  <h1>Mapa en vivo con Leaflet</h1>
  <div id="map"></div>

  <!-- Librería Leaflet -->
  <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

  <!-- Ejemplo de inicialización del mapa -->
  <script>
    // Crear el mapa centrado en Mérida, Yucatán
    var map = L.map('map').setView([20.9674, -89.5926], 13);

    // Añadir capa base de OpenStreetMap
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    // Ejemplo: marcador en Mérida
    L.marker([20.9674, -89.5926]).addTo(map)
      .bindPopup('Mérida, Yucatán')
      .openPopup();
  </script>
</body>
</html>
